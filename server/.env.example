PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/dejaf
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Default admin created by `npm run seed` (only used if no admin exists yet)
SEED_ADMIN_NAME=DEJAF Admin
SEED_ADMIN_EMAIL=admin@dejaf.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Image uploads (see cloudinary.com dashboard — free tier). Uploads go here instead of
# local disk since Render's free tier filesystem is ephemeral and wipes on every redeploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
